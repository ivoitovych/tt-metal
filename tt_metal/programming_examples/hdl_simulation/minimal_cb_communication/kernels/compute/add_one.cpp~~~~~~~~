#include "compute_kernel_api.h"
#include "compute_kernel_api/common.h"

void MAIN {
    const uint32_t num_tiles = get_arg_val<uint32_t>(0);

    constexpr uint32_t cb_id_in = 0;
    constexpr uint32_t cb_id_out = 16;

    unary_op_init_common(cb_id_in, cb_id_out);  // Init for tile regs/CBs

    for (uint32_t i = 0; i < num_tiles; i++) {
        acquire_dst();
        cb_wait_front(cb_id_in, 1);
        cb_reserve_back(cb_id_out, 1);

        tile_regs_acquire();
        unpack_tile_to_dst(i, 0, 0, false);  // Unpack input tile i to dst reg 0
        // No operation - data passes through intact for comm demo
        tile_regs_commit();
        tile_regs_release();

        pack_dst(0, 0);  // Pack dst reg 0 to output CB
        cb_push_back(cb_id_out, 1);
        cb_pop_front(cb_id_in, 1);
        release_dst();
    }
}
