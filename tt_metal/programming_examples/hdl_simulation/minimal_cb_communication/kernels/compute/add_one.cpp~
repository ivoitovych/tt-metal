#include "compute_api.h"  // Includes sfpu ops

void kernel_main() {
    uint32_t num_tiles = get_arg_val<uint32_t>(0);  // From host

    constexpr uint32_t cb_id_in = 0;   // Input CB
    constexpr uint32_t cb_id_out = 16; // Output CB

    // Loop over tiles
    for (uint32_t i = 0; i < num_tiles; i++) {
        cb_wait_front(cb_id_in, 1);   // Wait for 1 tile from reader
        cb_reserve_space(cb_id_out, 1); // Reserve in output

        uint32_t src_addr = get_cb_read_ptr(cb_id_in);
        uint32_t dst_addr = get_cb_write_ptr(cb_id_out);

        // Simple compute: Add 1 to each element (tile is 32x32=1024 elements)
        for (uint32_t row = 0; row < TILE_HEIGHT; ++row) {
            for (uint32_t col = 0; col < TILE_WIDTH; ++col) {
                // Load, add, store (use sfpu::add for vectorized; scalar for minimal)
                float val = rtoc_float(ld_bf16(src_addr + row * TILE_WIDTH + col));
                st_bf16(dst_addr + row * TILE_WIDTH + col, ctof(val + 1.0f));
            }
        }

        cb_push_back(cb_id_out, 1);  // Push to writer
        cb_pop_front(cb_id_in, 1);  // Clear input slot
    }
}
