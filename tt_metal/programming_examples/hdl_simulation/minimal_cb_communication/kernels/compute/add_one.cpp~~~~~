#include "compute_kernel_api.h"
#include "compute_kernel_api/common.h"
#include "llk_api/llk_sfpu.h"

void MAIN {
    const uint32_t num_tiles = get_arg_val<uint32_t>(0);
    const float one = 1.0f;

    constexpr uint32_t cb_id_in = 0;
    constexpr uint32_t cb_id_out = 16;

    unary_op_init_common(cb_id_in, cb_id_out);

    for (uint32_t i = 0; i < num_tiles; i++) {
        acquire_dst();
        cb_wait_front(cb_id_in, 1);
        cb_reserve_back(cb_id_out, 1);

        tile_regs_acquire();
        unpack_tile(cb_id_in, i, 0);  // Unpack input tile to reg 0
        sfpu::add(0, one);  // Add 1.0f to reg 0 (vectorized SFPU)
        tile_regs_commit();
        tile_regs_release();

        pack_tile(0, cb_id_out);  // Pack reg 0 to output CB
        cb_push_back(cb_id_out, 1);
        cb_pop_front(cb_id_in, 1);
        release_dst();
    }
}
